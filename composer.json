{
    "name": "mihichx/clearvc",
    "description": "ClearVC — ультра-легкий, быстрый и безопасный PHP-микрофреймворк по схеме View-Controller.",
    "type": "project",
    "license": "MIT",
    "keywords": ["framework", "mvc", "clearvc", "microframework", "security"],
    "authors": [
        {
            "name": "Mihichx",
            "role": "Lead Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-fileinfo": "*"
    },
    "autoload": {
        "psr-4": {
            "Core\\": "core/",
            "App\\Controllers\\": "controllers/"
        }
    },
    "scripts": {
        "clear-cache": "php -r \"echo 'Кэш очищен'.PHP_EOL;\"",
        "post-install-cmd": [
            "php -r \"file_exists('config/config.php') || copy('config/config.example.php', 'config/config.php'); echo 'Файл конфигурации успешно создан.'.PHP_EOL;\""
        ]
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true
    }
}
