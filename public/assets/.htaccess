# Запрещаем доступ и запуск любых PHP скриптов в этой папке
<FilesMatch "\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Полностью отключаем движок PHP для этой директории
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
